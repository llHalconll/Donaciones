# ─────────────────────────────────────────────────────────────────────────────
# DonacionesSaaS — Variables de entorno
#
# Copia este archivo a .env.local para desarrollo.
# En Vercel, configura cada variable en Project Settings → Environment Variables.
# Nunca subas .env.local ni valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (público — expuesto al navegador de forma segura) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── URL canónica del sitio (público) ─────────────────────────────────────────
# OBLIGATORIA en producción. Usada en redirectTo de OAuth y emails de Supabase.
# En Vercel se puede dejar vacía y se resolverá automáticamente, pero se
# recomienda fijar el dominio real para evitar redirecciones ambiguas.
NEXT_PUBLIC_SITE_URL=https://dominio-real.example

# Opcional. Muestra un enlace de soporte en páginas de error.
# Dejar vacía para no mostrar el enlace.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Opcional. Username de una cuenta activa usada como demo pública.
# Dejar vacía para desactivar /demo y todos los enlaces de demo.
NEXT_PUBLIC_DEMO_USERNAME=

# ── Upstash Redis — Rate Limiting ─────────────────────────────────────────────
# AMBAS VARIABLES SON OBLIGATORIAS EN PRODUCCIÓN.
#
# Sin ellas, en un despliegue de producción real (VERCEL_ENV=production):
#   - Login, registro y Google OAuth serán rechazados con un error 503.
#   - El build y las preview branches funcionarán normalmente (fail-open).
#
# Cómo obtenerlas:
#   1. Ir a https://console.upstash.com
#   2. Crear una base de datos Redis (región us-east-1 recomendada para Vercel)
#   3. Copiar REST URL y REST Token desde la pestaña "REST API"
#
# NO las prefixes con NEXT_PUBLIC_: estas claves deben mantenerse en el servidor.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── Hotmart (privado — solo servidor) ─────────────────────────────────────────
# Requerido para verificar la autenticidad de los webhooks de Hotmart.
# Obtener en: Hotmart → Herramientas → Webhooks → tu webhook → Hottok
# HOTMART_WEBHOOK_SECRET=your-hotmart-hottok
# HOTMART_TOKEN=your-hotmart-api-token

# Desactiva el procesamiento real del webhook hasta implementar idempotencia.
HOTMART_WEBHOOK_ENABLED=false

# ── Supabase Service Role (privado — solo servidor, alto privilegio) ──────────
# Solo necesaria para scripts de administración o migraciones fuera de Supabase.
# NUNCA la uses en componentes de cliente ni en Server Actions accesibles al usuario.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
