# Public Supabase configuration (exposed to the browser by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site configuration
# REQUIRED in production. Replace this placeholder with the real canonical domain.
NEXT_PUBLIC_SITE_URL=https://dominio-real.example
# Optional. Leave empty to hide support mail links and show neutral copy.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional. Username of a real, active account owned by the platform.
# Leave empty to hide /demo and every demo link.
NEXT_PUBLIC_DEMO_USERNAME=

# Private and sensitive. Required in production for protected routes/actions.
# When absent or unavailable in production, protected operations return 503.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Private feature flag. The endpoint remains non-processing until signature
# verification, payload validation and idempotency are implemented.
HOTMART_WEBHOOK_ENABLED=false
# HOTMART_WEBHOOK_SECRET=your-hotmart-hmac-secret
# HOTMART_TOKEN=your-hotmart-api-token

# Private and highly sensitive. Not used by the browser application.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
